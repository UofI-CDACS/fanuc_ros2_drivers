# Copy this file to .env and fill in your values.
# .env is NOT committed to git -- never put real credentials in .env.example.

# Path to the MindVision SDK python demo folder.
# Can be absolute or relative to the workspace root.
MVSDK_PATH=/path/to/Mindvision SDK for linux V2.1.0.37/demo/python_demo

# FANUC robot connection
ROBOT_IP=192.168.x.x
ROBOT_NAME=ROBOT
