# Copy this file to .env and fill in your robot's values.
# .env is gitignored — never commit it with real IPs.
#
# Uncomment and fill in the block for whichever robot this machine runs.
#
# Robot 1 (bunsen — partner's machine)
# ROBOT_NAME=bunsen
# ROBOT_IP=192.168.0.100
# ROBOT_INDEX=1

# Robot 2 (beaker — this machine)
ROBOT_NAME=beaker
ROBOT_IP=192.168.0.101
ROBOT_INDEX=2
